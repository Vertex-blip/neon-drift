config_version=5

[application]
config/name="Neon Drift"
run/main_scene="res://scenes/game.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="A coastal time attack and drift game."

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=6

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.12, 0.17, 0.18, 1)

[physics]
common/physics_ticks_per_second=60

[input]
accelerate={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320),Object(InputEventJoypadMotion,"axis":5,"axis_value":1.0)]}
brake={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322),Object(InputEventJoypadMotion,"axis":4,"axis_value":1.0)]}
steer_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194319),Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]}
steer_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194321),Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]}
handbrake={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32),Object(InputEventJoypadButton,"button_index":0)]}
recover={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82)]}
camera_switch={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":67)]}
pause_game={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305),Object(InputEventJoypadButton,"button_index":6)]}
